{
  "manifest_version": 3,
  "name": "PosturePal — Posture & Fatigue Webcam Coach",
  "version": "1.0.0",
  "description": "Private webcam posture coach: slouch, tilt and lean detection plus blink/yawn fatigue tracking. 100% on-device, no video leaves your machine.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Open PosturePal",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}